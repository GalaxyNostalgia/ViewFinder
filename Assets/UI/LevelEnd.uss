/* Hidden until LevelEnd shows it. */
.end-panel {
    display: none;
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.end-card {
    width: 340px;
    align-items: center;
    padding: 36px 32px 28px 32px;
    background-color: rgb(250, 250, 248);
    border-radius: 4px;
}

.end-title {
    font-size: 30px;
    color: rgb(20, 20, 20);
    -unity-font-style: bold;
    margin-bottom: 26px;
}

.end-button {
    width: 250px;
    height: 48px;
    margin: 0 0 12px 0;
    padding: 0;
    font-size: 18px;
    color: rgb(20, 20, 20);
    background-color: rgb(255, 221, 0);
    border-width: 0;
    border-radius: 3px;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.end-button:hover {
    background-color: rgb(255, 236, 110);
}

.end-button--quiet {
    background-color: rgba(0, 0, 0, 0.08);
}

.end-button--quiet:hover {
    background-color: rgba(0, 0, 0, 0.16);
}
