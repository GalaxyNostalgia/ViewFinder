.menu-root {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    padding-left: 90px;
}

.menu-panel {
    align-items: flex-start;
}

.title {
    white-space: nowrap;
    padding: 4px 18px;
    font-size: 64px;
    letter-spacing: 6px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 4px;
    background-color: rgb(128, 128, 128);
}

.tagline {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 40px;
    background-color: rgb(128, 128, 128);
}

.menu-button {
    width: 260px;
    height: 54px;
    margin: 0 0 14px 0;
    padding: 0;
    font-size: 20px;
    color: rgb(20, 20, 20);
    background-color: rgb(255, 221, 0);
    border-width: 0;
    border-radius: 3px;
    transition-duration: 0.12s;
    transition-property: background-color, translate;
}

.menu-button:hover {
    background-color: rgb(255, 236, 110);
    translate: 6px 0;
}

.menu-button:active {
    background-color: rgb(226, 195, 0);
}

.menu-button--quiet {
    background-color: rgba(255, 255, 255, 0.12);
    color: rgb(255, 255, 255);
}

.menu-button--quiet:hover {
    background-color: rgba(255, 255, 255, 0.22);
}

.hint {
    position: absolute;
    left: 90px;
    bottom: 40px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    background-color: rgb(128, 128, 128);
}
