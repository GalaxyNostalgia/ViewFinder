.hud-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* The photo you are holding, bottom-right. Hidden until PhotoHandHUD.ShowPhoto is
   called, so an empty card never sits on screen. */
.photo-card {
    display: none;
    position: absolute;
    right: 40px;
    bottom: 40px;
    width: 240px;
    background-color: rgb(250, 250, 248);
    padding: 10px 10px 34px 10px;
    rotate: 3deg;
    border-radius: 2px;
}

/* 16:9 so the preview matches what the capture frustum actually takes. */
.photo-image {
    width: 220px;
    height: 124px;
    background-color: rgb(18, 18, 18);
    -unity-background-scale-mode: scale-and-crop;
}
